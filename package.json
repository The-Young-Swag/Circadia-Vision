{
  "name": "circadia",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:sync": "npm run dev --workspace=sync-server",
    "dev:all": "concurrently \"npm run dev --workspace=web\" \"npm run dev --workspace=sync-server\"",
    "build": "npm run build --workspace=web",
    "build:sync": "npm run build --workspace=sync-server",
    "test": "npm run test --workspace=web",
    "lint": "npm run lint --workspace=web",
    "generate-routes": "npm run generate-routes --workspace=web"
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
